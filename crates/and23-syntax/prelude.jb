// Biblioteca base de And23, escrita en el propio lenguaje. Toda sesión la ejecuta antes del programa.
// Usa genéricos con erasure: en ejecución `T` no existe, así que los valores no se "encajonan".

// --- Lista<T>: una lista que crece (sobre un arreglo) ---
thing Lista<T>() {
    mut items: [T] = []

    fn agrega(x: T) { push(items, x) }
    fn tam() -> Int = len(items)
    fn vacia() -> Bool = len(items) == 0
    fn obtiene(i: Int) -> T = items[i]
    fn pone(i: Int, x: T) { items[i] = x }

    /// Quita y devuelve el último elemento.
    fn quita() -> T = pop(items)

    /// Posición de la primera aparición de `x` (con `==`), o -1.
    fn indiceDe(x: T) -> Int {
        mut i = 0
        while i < len(items) {
            if items[i] == x { return i }
            i += 1
        }
        return 0 - 1
    }

    fn contiene(x: T) -> Bool = indiceDe(x) >= 0

    /// Inserta `x` antes de la posición `i` (`i == tam()` agrega al final).
    fn inserta(i: Int, x: T) {
        fix nuevo: [T] = []
        mut j = 0
        while j < len(items) {
            if j == i { push(nuevo, x) }
            push(nuevo, items[j])
            j += 1
        }
        if i >= len(items) { push(nuevo, x) }
        items = nuevo
    }

    /// Quita y devuelve el elemento de la posición `i`.
    fn quitaEn(i: Int) -> T {
        fix sacado = items[i]
        fix nuevo: [T] = []
        mut j = 0
        while j < len(items) {
            if j != i { push(nuevo, items[j]) }
            j += 1
        }
        items = nuevo
        return sacado
    }

    fn copia() -> Lista<T> {
        fix otra = Lista<T>()
        mut i = 0
        while i < len(items) {
            otra.agrega(items[i])
            i += 1
        }
        return otra
    }

    // --- Con lambdas ---

    /// Llama a `f` con cada elemento, en orden.
    fn paraCada(f: (T) -> Unit) {
        mut i = 0
        while i < len(items) {
            f(items[i])
            i += 1
        }
    }

    /// Una lista nueva con `f` aplicada a cada elemento.
    fn map<R>(f: (T) -> R) -> Lista<R> {
        fix res = Lista<R>()
        mut i = 0
        while i < len(items) {
            res.agrega(f(items[i]))
            i += 1
        }
        return res
    }

    /// Una lista nueva con los elementos para los que `f` da verdadero.
    fn filter(f: (T) -> Bool) -> Lista<T> {
        fix res = Lista<T>()
        mut i = 0
        while i < len(items) {
            if f(items[i]) { res.agrega(items[i]) }
            i += 1
        }
        return res
    }

    /// Combina los elementos de izquierda a derecha: `f(f(inicial, a), b)`.
    fn reduce<R>(inicial: R, f: (R, T) -> R) -> R {
        mut acc = inicial
        mut i = 0
        while i < len(items) {
            acc = f(acc, items[i])
            i += 1
        }
        return acc
    }

    /// El primer elemento para el que `f` da verdadero, o nil.
    fn busca(f: (T) -> Bool) -> T? {
        mut i = 0
        while i < len(items) {
            if f(items[i]) { return items[i] }
            i += 1
        }
        return nil
    }

    fn alguno(f: (T) -> Bool) -> Bool {
        mut i = 0
        while i < len(items) {
            if f(items[i]) { return true }
            i += 1
        }
        return false
    }

    fn todos(f: (T) -> Bool) -> Bool {
        mut i = 0
        while i < len(items) {
            if !f(items[i]) { return false }
            i += 1
        }
        return true
    }

    /// Ordena la lista con `antes(a, b)` (verdadero si `a` va antes que `b`). Es estable.
    fn ordena(antes: (T, T) -> Bool) {
        mut i = 1
        while i < len(items) {
            fix x = items[i]
            mut j = i - 1
            while j >= 0 && antes(x, items[j]) {
                items[j + 1] = items[j]
                j -= 1
            }
            items[j + 1] = x
            i += 1
        }
    }

    fn texto() -> Str = "${items}"
}

// --- Mapa<K, V>: una tabla hash con cubetas ---
thing Entrada<K, V>(fix clave: K, mut valor: V)

fn _cubetasVacias<K, V>(n: Int) -> [[Entrada<K, V>]] {
    mut todas: [[Entrada<K, V>]] = []
    mut i = 0
    while i < n {
        fix vacia: [Entrada<K, V>] = []
        push(todas, vacia)
        i += 1
    }
    return todas
}

thing Mapa<K, V>() {
    mut cubetas: [[Entrada<K, V>]] = _cubetasVacias<K, V>(8)
    mut cantidad = 0

    fn tam() -> Int = cantidad
    fn vacio() -> Bool = cantidad == 0

    fn cubetaDe(clave: K) -> [Entrada<K, V>] = cubetas[hash(clave) % len(cubetas)]

    /// Asocia `clave` con `valor`; si ya estaba, reemplaza el valor.
    fn pone(clave: K, valor: V) {
        fix cubeta = cubetaDe(clave)
        mut i = 0
        while i < len(cubeta) {
            if cubeta[i].clave == clave {
                cubeta[i].valor = valor
                return
            }
            i += 1
        }
        push(cubeta, Entrada<K, V>(clave, valor))
        cantidad += 1
        if cantidad > len(cubetas) * 2 { crece() }
    }

    /// El valor de `clave`, o nil si no está.
    fn obtiene(clave: K) -> V? {
        fix cubeta = cubetaDe(clave)
        mut i = 0
        while i < len(cubeta) {
            if cubeta[i].clave == clave { return cubeta[i].valor }
            i += 1
        }
        return nil
    }

    fn contiene(clave: K) -> Bool {
        fix cubeta = cubetaDe(clave)
        mut i = 0
        while i < len(cubeta) {
            if cubeta[i].clave == clave { return true }
            i += 1
        }
        return false
    }

    /// Quita `clave`; devuelve si estaba.
    fn quita(clave: K) -> Bool {
        fix pos = hash(clave) % len(cubetas)
        fix cubeta = cubetas[pos]
        fix nueva: [Entrada<K, V>] = []
        mut hallada = false
        mut i = 0
        while i < len(cubeta) {
            if cubeta[i].clave == clave { hallada = true } else { push(nueva, cubeta[i]) }
            i += 1
        }
        if hallada {
            cubetas[pos] = nueva
            cantidad -= 1
        }
        return hallada
    }

    fn claves() -> Lista<K> {
        fix res = Lista<K>()
        mut i = 0
        while i < len(cubetas) {
            fix cubeta = cubetas[i]
            mut j = 0
            while j < len(cubeta) {
                res.agrega(cubeta[j].clave)
                j += 1
            }
            i += 1
        }
        return res
    }

    fn valores() -> Lista<V> {
        fix res = Lista<V>()
        mut i = 0
        while i < len(cubetas) {
            fix cubeta = cubetas[i]
            mut j = 0
            while j < len(cubeta) {
                res.agrega(cubeta[j].valor)
                j += 1
            }
            i += 1
        }
        return res
    }

    /// Llama a `f(clave, valor)` con cada entrada.
    fn paraCada(f: (K, V) -> Unit) {
        mut i = 0
        while i < len(cubetas) {
            fix cubeta = cubetas[i]
            mut j = 0
            while j < len(cubeta) {
                f(cubeta[j].clave, cubeta[j].valor)
                j += 1
            }
            i += 1
        }
    }

    fn crece() {
        fix viejas = cubetas
        cubetas = _cubetasVacias<K, V>(len(viejas) * 2)
        cantidad = 0
        mut i = 0
        while i < len(viejas) {
            fix cubeta = viejas[i]
            mut j = 0
            while j < len(cubeta) {
                pone(cubeta[j].clave, cubeta[j].valor)
                j += 1
            }
            i += 1
        }
    }
}

// --- Texto: los métodos de Str (`s.largo()`, `s.parte(",")`...) son estas funciones, con la cadena
// como primer argumento. Las posiciones cuentan caracteres, igual que `len`. ---
fn _str_largo(s: Str) -> Int = len(s)
fn _str_vacia(s: Str) -> Bool = len(s) == 0
fn _str_recorta(s: Str) -> Str = _recorta(s)
fn _str_mayus(s: Str) -> Str = _mayus(s)
fn _str_minus(s: Str) -> Str = _minus(s)
fn _str_contiene(s: Str, t: Str) -> Bool = _busca(s, t, 0) >= 0
fn _str_indiceDe(s: Str, t: Str) -> Int = _busca(s, t, 0)
fn _str_empiezaCon(s: Str, t: Str) -> Bool = _empieza(s, t)
fn _str_terminaCon(s: Str, t: Str) -> Bool = _termina(s, t)
fn _str_reemplaza(s: Str, de: Str, por: Str) -> Str = _reemplaza(s, de, por)
fn _str_trozo(s: Str, desde: Int, hasta: Int) -> Str = _trozo(s, desde, hasta)

/// Trozos de `s` separados por `sep`; con `sep` vacío, un trozo por carácter.
fn _str_parte(s: Str, sep: Str) -> Lista<Str> = listaDe(_parte(s, sep))

/// Las líneas de `s` (separadas por "\n" o "\r\n"); un salto final no crea una línea vacía.
fn _str_lineas(s: Str) -> Lista<Str> {
    fix crudas = _str_parte(s, "\n")
    fix lineas = Lista<Str>()
    mut i = 0
    while i < crudas.tam() {
        mut linea = crudas.obtiene(i)
        if _termina(linea, "\r") { linea = _trozo(linea, 0, len(linea) - 1) }
        lineas.agrega(linea)
        i += 1
    }
    if lineas.tam() > 0 && len(lineas.obtiene(lineas.tam() - 1)) == 0 { lineas.quita() }
    return lineas
}

/// Une las cadenas de `partes` poniendo `sep` entre ellas.
fn une(partes: Lista<Str>, sep: Str) -> Str = _une(partes.items, sep)

// --- Números: `Int.parse(s)` y `Float.parse(s)` devuelven nil si el texto no es un número ---
fn _int_parse(s: Str) -> Int? = _parseInt(_recorta(s))
fn _float_parse(s: Str) -> Float? = _parseFloat(_recorta(s))

fn absoluto(n: Int) -> Int {
    if n < 0 { return 0 - n }
    return n
}
fn minimo(a: Int, b: Int) -> Int {
    if a < b { return a }
    return b
}
fn maximo(a: Int, b: Int) -> Int {
    if a > b { return a }
    return b
}
fn absolutoF(x: Float) -> Float {
    if x < 0.0 { return 0.0 - x }
    return x
}
fn minimoF(a: Float, b: Float) -> Float {
    if a < b { return a }
    return b
}
fn maximoF(a: Float, b: Float) -> Float {
    if a > b { return a }
    return b
}

// --- Archivos: los fallos de lectura y escritura lanzan ErrorES (un Fallo) ---
thing ErrorES(m: Str) : Fallo(m)

fn leeArchivo(ruta: Str) -> Str {
    fix contenido = _leeArchivo(ruta)
    if contenido != nil { return contenido }
    fail ErrorES(_errorES())
}

fn leeLineas(ruta: Str) -> Lista<Str> = leeArchivo(ruta).lineas()

fn escribeArchivo(ruta: Str, texto: Str) {
    if !_escribeArchivo(ruta, texto) { fail ErrorES(_errorES()) }
}

fn borraArchivo(ruta: Str) {
    if !_borraArchivo(ruta) { fail ErrorES(_errorES()) }
}

fn agregaArchivo(ruta: Str, texto: Str) {
    if !_agregaArchivo(ruta, texto) { fail ErrorES(_errorES()) }
}

// ---------------------------------------------------------------- M11: tareas y canales

/// Un `Fallo` de una tarea y si alguien lo recibió (con `espera()`). Los que nadie vio se avisan al terminar el programa.
thing FalloDeTarea(fix error: Fallo) {
    mut visto = false
}

/// Los fallos de las tareas que terminaron mal, en orden. `_fallosPerdidos` los revisa y la vacía.
fix _fallosDeTareas = Lista<FalloDeTarea>()

/// Lo llama el programa `and23` al terminar: si alguna tarea falló y nadie la esperó, lanza un `Fallo` que lo cuenta.
fn _fallosPerdidos() {
    fix perdidos = Lista<Str>()
    _fallosDeTareas.paraCada { f -> if !f.visto { perdidos.agrega(f.error.msg) } }
    while !_fallosDeTareas.vacia() { _fallosDeTareas.quita() }
    if !perdidos.vacia() {
        fail Fallo("${perdidos.tam()} tarea(s) fallaron y nadie las esperó: ${une(perdidos, "; ")}")
    }
}

/// Una tarea sin resultado (`lanza`). Guarda si terminó y, si falló, el `Fallo`.
thing Tarea() {
    mut listo = false
    mut error: Fallo? = nil
    mut aviso: FalloDeTarea? = nil

    fn terminada() -> Bool = listo

    /// Bloquea hasta que la tarea termine. Si terminó con un `Fallo`, lo relanza aquí.
    fn espera() {
        while !listo { _bloquea() }
        fix e = error
        fix a = aviso
        if a != nil { a.visto = true }
        if e != nil { fail e }
    }

    fn corre(f: () -> Unit) {
        attempt { f() } rescue e: Fallo {
            error = e
            fix a = FalloDeTarea(e)
            aviso = a
            _fallosDeTareas.agrega(a)
        }
        listo = true
        _avisa()
    }
}

/// Una tarea con resultado (`lanzaDe`).
thing TareaDe<T>() {
    mut listo = false
    mut resultado: [T] = []
    mut error: Fallo? = nil
    mut aviso: FalloDeTarea? = nil

    fn terminada() -> Bool = listo

    fn espera() -> T {
        while !listo { _bloquea() }
        fix e = error
        fix a = aviso
        if a != nil { a.visto = true }
        if e != nil { fail e }
        return resultado[0]
    }

    fn corre(f: () -> T) {
        attempt { resultado = [f()] } rescue e: Fallo {
            error = e
            fix a = FalloDeTarea(e)
            aviso = a
            _fallosDeTareas.agrega(a)
        }
        listo = true
        _avisa()
    }
}

/// Crea una tarea que ejecuta `f` y vuelve de inmediato; la tarea empieza cuando la actual cede o espera.
fn lanza(f: () -> Unit) -> Tarea {
    fix t = Tarea()
    _lanza({ t.corre(f) })
    return t
}

/// Como `lanza`, pero la tarea devuelve un valor que `espera()` entrega.
fn lanzaDe<T>(f: () -> T) -> TareaDe<T> {
    fix t = TareaDe<T>()
    _lanza({ t.corre(f) })
    return t
}

thing ErrorCanal(m: Str) : Fallo(m)

/// Cola con capacidad entre tareas. `envia` espera si está llena; `recibe` espera si está vacía y
/// devuelve `nil` cuando el canal está cerrado y vacío.
thing Canal<T>(fix capacidad: Int) {
    mut items: [T] = []
    mut inicio = 0
    mut cerrado = false

    fn tam() -> Int = len(items) - inicio
    fn estaCerrado() -> Bool = cerrado

    fn envia(x: T) {
        mut tope = capacidad
        if tope < 1 { tope = 1 }
        while !cerrado && tam() >= tope { _bloquea() }
        if cerrado { fail ErrorCanal("canal cerrado") }
        push(items, x)
        _avisa()
    }

    fn recibe() -> T? {
        while tam() == 0 && !cerrado { _bloquea() }
        if tam() == 0 { return nil }
        fix x = items[inicio]
        inicio += 1
        if inicio == len(items) {
            items = []
            inicio = 0
        }
        _avisa()
        return x
    }

    fn cierra() {
        cerrado = true
        _avisa()
    }
}

// ---------------------------------------------------------------- M12: biblioteca estándar 2

/// Una `Lista` con los elementos de un arreglo: `listaDe([1, 2, 3])`.
fn listaDe<T>(xs: [T]) -> Lista<T> {
    fix l = Lista<T>()
    mut i = 0
    while i < len(xs) {
        l.agrega(xs[i])
        i += 1
    }
    return l
}

/// Dos valores juntos, de tipos distintos: `Dupla("edad", 30)`.
thing Dupla<A, B>(fix primero: A, fix segundo: B) {
    fn intercambiada() -> Dupla<B, A> = Dupla(segundo, primero)
}

/// Los argumentos que siguen al archivo en la línea de comandos: `and23 programa.jb uno dos`.
fn argumentos() -> Lista<Str> = listaDe(_args())

/// Valor de una variable de entorno, o nil si no existe.
fn entorno(nombre: Str) -> Str? = _entorno(nombre)

/// Milisegundos desde el 1 de enero de 1970 (UTC).
fn ahora() -> Int = _ahora()

/// Espera `ms` milisegundos. Mientras tanto otras tareas pueden avanzar; si no hay ninguna lista, duerme de verdad.
fn duerme(ms: Int) {
    fix fin = _ahora() + ms
    while true {
        fix resta = fin - _ahora()
        if resta <= 0 { break }
        if _hayListas() {
            cede()
            if fin - _ahora() > 1 { _pausa(1) }
        } else {
            _pausa(resta)
        }
    }
}

/// Entero al azar en [0, n). `n` debe ser positivo.
fn azar(n: Int) -> Int = _azar(n)

/// Decimal al azar en [0, 1).
fn azarF() -> Float = _azarF()

/// Fija la semilla: la misma semilla da siempre la misma secuencia.
fn semilla(n: Int) { _semilla(n) }

fn esDir(ruta: Str) -> Bool = _esDir(ruta)

/// Nombres (no rutas) del contenido de una carpeta, en orden alfabético.
fn listaDir(ruta: Str) -> Lista<Str> {
    fix nombres = _listaDir(ruta)
    if nombres != nil { return listaDe(nombres) }
    fail ErrorES(_errorES())
}

/// Crea la carpeta y las que falten por encima.
fn creaDir(ruta: Str) {
    if !_creaDir(ruta) { fail ErrorES(_errorES()) }
}

/// Posición del último separador (`/` o `\`) de la ruta, o -1.
fn _ultimoSep(ruta: Str) -> Int {
    mut i = len(ruta) - 1
    while i >= 0 {
        if ruta[i] == "/" || ruta[i] == "\\" { return i }
        i -= 1
    }
    return -1
}

/// Une dos partes de una ruta con `/`; si la segunda es absoluta, gana.
fn unirRuta(a: Str, b: Str) -> Str {
    if len(a) == 0 { return b }
    if b.empiezaCon("/") || b.empiezaCon("\\") { return b }
    if a.terminaCon("/") || a.terminaCon("\\") { return a + b }
    return a + "/" + b
}

/// Último componente de la ruta: `nombreDe("a/b/c.txt")` es `c.txt`.
fn nombreDe(ruta: Str) -> Str = ruta.trozo(_ultimoSep(ruta) + 1, len(ruta))

/// La ruta sin su último componente (`""` si no tiene separador).
fn carpetaDe(ruta: Str) -> Str {
    fix i = _ultimoSep(ruta)
    if i < 0 { return "" }
    if i == 0 { return ruta.trozo(0, 1) }
    return ruta.trozo(0, i)
}

/// Extensión del último componente sin el punto (`""` si no tiene): `extension("a/c.tar.gz")` es `gz`.
fn extension(ruta: Str) -> Str {
    fix nombre = nombreDe(ruta)
    mut i = len(nombre) - 1
    while i > 0 {
        if nombre[i] == "." { return nombre.trozo(i + 1, len(nombre)) }
        i -= 1
    }
    return ""
}

// ---------------------------------------------------------------- pruebas (`prueba "nombre" { ... }`)

/// La excepción de una afirmación que no se cumple.
thing FalloPrueba(m: Str) : Fallo(m)

/// Falla la prueba si `condicion` es falsa.
fn afirma(condicion: Bool) {
    if !condicion { fail FalloPrueba("la afirmación es falsa") }
}

/// Falla la prueba si `real` y `esperado` no son iguales (`==`).
fn afirmaIgual<T>(real: T, esperado: T) {
    if real != esperado { fail FalloPrueba("se esperaba ${esperado}, pero fue ${real}") }
}

// ---------------------------------------------------------------- texto para el lexer de Mn

/// ¿Es una letra Unicode (y solo letras)? `"ñ".esLetra()` es true; `"".esLetra()` es false.
fn _str_esLetra(s: Str) -> Bool = _esLetra(s)

/// ¿Letras o dígitos Unicode, y no está vacía?
fn _str_esAlfanumerico(s: Str) -> Bool = _esAlfanum(s)

/// ¿Solo dígitos ASCII (0-9), y no está vacía?
fn _str_esDigito(s: Str) -> Bool = _esDigito(s)

/// Cada carácter como una cadena, en una `Lista<Str>` (O(n): para recorrer un texto largo es mucho más
/// rápido que `s[i]`, que cuenta desde el principio cada vez).
fn _str_caracteres(s: Str) -> Lista<Str> = listaDe(_caracteres(s))

/// El carácter con ese punto de código Unicode, o nil si no es uno válido.
fn desdeCodigo(n: Int) -> Str? = _desdeCodigo(n)

// ---------------------------------------------------------------- enumerados

/// La lista de las variantes de un enumerado (`Color.todos`).
fn _variantes<T>(xs: [T]) -> Lista<T> {
    fix l = Lista<T>()
    mut i = 0
    while i < len(xs) {
        l.agrega(xs[i])
        i += 1
    }
    return l
}
