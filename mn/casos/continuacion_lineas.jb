// Saltos de línea que no terminan la sentencia: dentro de ( y [, tras un operador y antes de .  ?.  &&  ||  ?:
fn suma(
    a: Int,
    b: Int
) -> Int = a +
    b

thing Punto(
    fix x: Int,
    fix y: Int
)

fix p = Punto(
    1,
    2
)
fix cuenta = [
