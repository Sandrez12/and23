    2,
]
fix r = listaDe(cuenta)
    .map { n -> n * 2 }
    .filter { n -> n > 2 }
fix ok = p.x == 1
    && p.y == 2
    || false
fix v: Int? = nil
fix w = v
    ?: 7
mut total = 0
total +=
    5
fix px = p
    .x
show(suma(1, 2))
