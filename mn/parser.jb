// Mn, paso 2: el parser de And23 escrito en And23.
//
// Hace lo mismo que `crates/and23-syntax/src/parser.rs`, incluidas las traducciones de `enum`, `match`,
// `if` como valor y `prueba`, y vuelca el árbol con el mismo formato que `and23 --ast`:
//
//     and23 mn/parser.jb archivo.jb
//
// El árbol es uniforme: un `Nodo` tiene una etiqueta, unos atributos (texto) y unos hijos. Es el mismo
// formato del volcado, así que construirlo y mostrarlo es lo mismo. Más adelante un AST con clases
// ganaría seguridad de tipos; por ahora lo importante es comparar con el parser de Rust.
//
// Cada nodo lleva su posición (`@desde-hasta`) y la de su nombre (`#desde-hasta`) en caracteres, como el
// volcado de Rust, y los errores también.

use "lexer.jb"

/// Un rango de caracteres `[a, b)` del texto fuente.
open thing Rango(fix a: Int, fix b: Int) {
    /// El menor rango que cubre a los dos.
    fn to(o: Rango) -> Rango = Rango(minimo(a, o.a), maximo(b, o.b))
}

open fn rango(t: Token) -> Rango = Rango(t.desde, t.hasta)

open thing ErrorParse(m: Str, fix donde: Rango) : Fallo(m)

/// Un nombre (posiblemente cualificado) y dónde está.
thing Nom(fix nombre: Str, fix r: Rango)

open thing Nodo(mut tag: Str, mut attrs: Str, fix kids: Lista<Nodo>) {
    /// Posición del nodo y de su nombre; -1 si no la tiene.
    mut d = -1
    mut h = -1
    mut nd = -1
    mut nh = -1

    fn en(r: Rango) -> Nodo {
        d = r.a
        h = r.b
        return this
    }

    fn nom(r: Rango) -> Nodo {
        nd = r.a
        nh = r.b
        return this
    }
}

/// La posición de un nodo.
open fn rg(n: Nodo) -> Rango = Rango(n.d, n.h)

/// La posición de una sentencia: una expresión suelta ocupa lo que su expresión.
open fn spanDe(n: Nodo) -> Rango = if n.tag == "ExprStmt" { rg(n.kids.obtiene(0)) } else { rg(n) }

open fn hoja(tag: Str, attrs: Str) -> Nodo = Nodo(tag, attrs, Lista<Nodo>())

open fn vacio(tag: Str) -> Nodo = Nodo(tag, "", Lista<Nodo>())

fn nada() -> Nodo = hoja("None", "")

open fn con(tag: Str, attrs: Str, kids: Lista<Nodo>) -> Nodo = Nodo(tag, attrs, kids)

fn uno(tag: Str, attrs: Str, a: Nodo) -> Nodo {
    fix k = Lista<Nodo>()
    k.agrega(a)
    return Nodo(tag, attrs, k)
}

fn dos(tag: Str, attrs: Str, a: Nodo, b: Nodo) -> Nodo {
    fix k = Lista<Nodo>()
    k.agrega(a)
    k.agrega(b)
    return Nodo(tag, attrs, k)
}

fn tres(tag: Str, attrs: Str, a: Nodo, b: Nodo, c: Nodo) -> Nodo {
    fix k = Lista<Nodo>()
    k.agrega(a)
    k.agrega(b)
    k.agrega(c)
    return Nodo(tag, attrs, k)
}

fn cuatro(tag: Str, attrs: Str, a: Nodo, b: Nodo, c: Nodo, d: Nodo) -> Nodo {
    fix k = Lista<Nodo>()
    k.agrega(a)
    k.agrega(b)
    k.agrega(c)
    k.agrega(d)
    return Nodo(tag, attrs, k)
}

fn comillas(s: Str) -> Str = "\"${escapa(s)}\""

fn listaDe1(a: Nodo) -> Lista<Nodo> {
    fix k = Lista<Nodo>()
    k.agrega(a)
    return k
}

/// `{ -> cuerpo }()`: ejecuta el cuerpo al instante; sus `return` dan el valor de la expresión.
fn inmediata(stmts: Lista<Nodo>, r: Rango) -> Nodo {
    fix lambda = dos("Lambda", "", vacio("LParams"), con("Block", "", stmts).en(r)).en(r)
    return dos("CallValue", "", lambda, vacio("Args")).en(r)
}

// ---------------------------------------------------------------- tablas

fix BIN = tabla("OrOr~|| AndAnd~&& EqEq~== NotEq~!= Lt~< LtEq~<= Gt~> GtEq~>= Plus~+ Minus~- Star~* Slash~/ Percent~%")
fix ASIGNA = tabla("Assign~= PlusEq~+= MinusEq~-= StarEq~*= SlashEq~/= PercentEq~%=")

/// Enlace izquierdo de un operador binario (el derecho es uno más); 0 si el token no es un operador.
fn bpIzq(t: Str) -> Int = match t {
    "OrOr" -> 1
    "AndAnd" -> 3
    "EqEq", "NotEq" -> 5
    "Lt", "LtEq", "Gt", "GtEq" -> 7
    "Plus", "Minus" -> 9
    "Star", "Slash", "Percent" -> 11
    _ -> 0
}

/// Cómo se nombra un token en los mensajes de error.
fn describe(t: Token) -> Str {
    match t.tipo {
        "Int" -> return "el entero `${t.valor}`"
        "Float" -> {
            mut v = t.valor
            if v.largo() > 2 && v.trozo(v.largo() - 2, v.largo()) == ".0" { v = v.trozo(0, v.largo() - 2) }
            return "el decimal `${v}`"
        }
        "Ident" -> return "el identificador `${t.valor}`"
        "Str" -> return "una cadena"
        "Newline" -> return "el fin de la línea"
        "Eof" -> return "el fin del programa"
        _ -> return "`${TEXTOS.obtiene(t.tipo) ?: t.tipo}`"
    }
}

// ---------------------------------------------------------------- casos de match

/// Un patrón: `_` (clase "Wild"), una expresión (clase "Value") o `nombre: Tipo` (clase "Typed").
thing Pat(fix clase: Str, fix valor: Nodo, fix nombre: Str, fix ty: Nodo, fix r: Rango)

/// Un caso: sus patrones, su cuerpo (un `Block`) y su posición.
thing Caso(fix pats: Lista<Pat>, fix cuerpo: Nodo, fix r: Rango)

thing Casos(fix scrut: Nodo, fix casos: Lista<Caso>, fix cierre: Rango)

thing Contador() {
    mut n = 0
}

thing Parser(fix toks: Lista<Token>, fix enums: Mapa<Str, Lista<Str>>, fix cont: Contador, mut fnDepth: Int, mut loopDepth: Int) {
    mut pos = 0
    mut noTrailing = false
    /// Posición del último `)` (o de la última lambda final) de unos argumentos.
    mut cierre = Rango(0, 0)

    // ------------------------------------------------------------ utilidades

    fn peek() -> Token = toks.obtiene(pos)

    fn peekAt(k: Int) -> Token = toks.obtiene(minimo(pos + k, toks.tam() - 1))

    fn tipo() -> Str = toks.obtiene(pos).tipo

    /// Consume el token actual; el `Eof` final no se consume nunca.
    fn bump() -> Token {
        fix t = toks.obtiene(pos)
        if pos < toks.tam() - 1 { pos += 1 }
        return t
    }

    fn skipNewlines() {
        while tipo() == "Newline" { bump() }
    }

    /// Un error en el token actual.
    fn aqui(msg: Str) -> ErrorParse = ErrorParse(msg, rango(peek()))

    fn expect(t: Str, que: Str) -> Token {
        if tipo() == t { return bump() }
        fail aqui("se esperaba ${que}, pero se encontró ${describe(peek())}")
    }

    fn expectIdentT(que: Str) -> Token {
        if tipo() == "Ident" { return bump() }
        fail aqui("se esperaba ${que}, pero se encontró ${describe(peek())}")
    }

    fn expectIdent(que: Str) -> Str = expectIdentT(que).valor

    /// Tras una sentencia debe venir un salto de línea, o el cierre del bloque / fin del archivo.
    fn finSentencia(enBloque: Bool) {
        fix t = tipo()
        if t == "Newline" { return }
        if t == "Eof" && !enBloque { return }
        if t == "RBrace" && enBloque { return }
        if t == "Eof" { fail aqui("se esperaba `}` para cerrar el bloque") }
        fail aqui("se esperaba el fin de la sentencia, pero se encontró ${describe(peek())}")
    }

    /// Nombre de tipo o de clase, posiblemente cualificado por el alias de un `use`: `util.Persona`.
    fn identCualificado(que: Str) -> Nom {
        fix primero = expectIdentT(que)
        mut nombre = primero.valor
        mut r = rango(primero)
        if tipo() == "Dot" && peekAt(1).tipo == "Ident" {
            bump()
            fix miembro = bump()
            r = r.to(rango(miembro))
            nombre = nombre + "." + miembro.valor
        }
        return Nom(nombre, r)
    }

    fn esPalabra(k: Int, w: Str) -> Bool = peekAt(k).tipo == "Ident" && peekAt(k).valor == w

    fn puedeTrail() -> Bool = !noTrailing && tipo() == "LBrace"

    /// Analiza una expresión con las lambdas finales permitidas (dentro de paréntesis y corchetes).
    fn exprAnidada() -> Nodo {
        fix guardado = noTrailing
        noTrailing = false
        fix e = expr(0)
        noTrailing = guardado
        return e
    }

    /// Condición de `if`/`while`: una `{` tras ella abre el cuerpo, no es una lambda final.
    fn condicion() -> Nodo {
        fix guardado = noTrailing
        noTrailing = true
        fix e = expr(0)
        noTrailing = guardado
        return e
    }

    // ------------------------------------------------------------ programa

    fn usoDecl() -> Nodo {
        fix inicio = rango(bump())
        if tipo() != "Str" { fail aqui("se esperaba la ruta entre comillas después de `use`") }
        fix ruta = bump()
        fix partes = ruta.partes
        if partes.tam() != 1 || partes.obtiene(0).esCodigo || partes.obtiene(0).texto == "" {
            fail ErrorParse("la ruta de `use` es un texto fijo, sin `\${}` y no vacío", rango(ruta))
        }
        mut r = inicio.to(rango(ruta))
        mut alias = "-"
        if esPalabra(0, "como") {
            bump()
            fix a = expectIdentT("el alias después de `como`")
            alias = a.valor
            r = r.to(rango(a))
        }
        return hoja("Use", "${comillas(partes.obtiene(0).texto)} ${alias}").en(r)
    }

    /// `prueba "nombre" { ... }`: una función `_prueba_N` con el cuerpo; deja el registro en `tests`.
    fn pruebaDecl(indice: Int, tests: Lista<Nodo>) -> Nodo {
        fix inicio = rango(bump())
        if tipo() != "Str" { fail aqui("se esperaba el nombre de la prueba entre comillas") }
        fix nt = bump()
        fix nsp = rango(nt)
        fix partes = nt.partes
        if partes.tam() != 1 || partes.obtiene(0).esCodigo || partes.obtiene(0).texto == "" {
            fail ErrorParse("el nombre de una prueba es un texto fijo, sin `\${}` y no vacío", nsp)
        }
        fnDepth += 1
        fix cuerpo = bloque()
        fnDepth -= 1
        fix func = "_prueba_${indice}"
        tests.agrega(hoja("Test", "${comillas(partes.obtiene(0).texto)} ${func}").en(nsp))
        return cuatro("Fn", "${func} false", vacio("TypeParams"), vacio("Params"), nada(), cuerpo).en(inicio.to(rg(cuerpo))).nom(nsp)
    }

    fn programa() -> Nodo {
        fix usos = Lista<Nodo>()
        fix exports = Lista<Str>()
        fix tests = Lista<Nodo>()
        fix stmts = Lista<Nodo>()
        while true {
            skipNewlines()
            if tipo() == "Eof" { break }
            if esPalabra(0, "prueba") && peekAt(1).tipo == "Str" {
                stmts.agrega(pruebaDecl(tests.tam(), tests))
                finSentencia(false)
                continue
            }
            if esPalabra(0, "use") && peekAt(1).tipo == "Str" {
                usos.agrega(usoDecl())
                finSentencia(false)
                continue
            }
            fix abrir = esPalabra(0, "open") && (peekAt(1).tipo == "Fn" || peekAt(1).tipo == "Thing" || peekAt(1).tipo == "Kind" || peekAt(1).tipo == "Enum" || peekAt(1).tipo == "Fix" || peekAt(1).tipo == "Mut")
            if abrir {
                bump()
                if tipo() == "Mut" {
                    fail aqui("una variable `mut` no se puede abrir: otro archivo no podría cambiarla; usa `open fix` o una función")
                }
            }
            if tipo() == "Enum" {
                fix decls = enumDecl(abrir, exports)
                decls.paraCada { d -> stmts.agrega(d) }
                finSentencia(false)
                continue
            }
            fix s = if tipo() == "Fn" { fnDecl() } else if tipo() == "Thing" { thingDecl() } else if tipo() == "Kind" { kindDecl() } else { stmt() }
            if abrir && (s.tag == "Fn" || s.tag == "Thing" || s.tag == "Kind" || s.tag == "Let") {
                exports.agrega(s.attrs.parte(" ").obtiene(0))
            }
            stmts.agrega(s)
            finSentencia(false)
        }
        fix raiz = Lista<Nodo>()
        raiz.agrega(con("Uses", "", usos))
        raiz.agrega(hoja("Exports", une(exports, " ")))
        raiz.agrega(con("Tests", "", tests))
        raiz.agrega(con("Stmts", "", stmts))
        return con("Program", "", raiz)
    }

    // ------------------------------------------------------------ enumerados, match e if como valor

    /// `enum Color { Rojo, Verde }`: una clase `Color(nombre, orden)`, una constante por variante
    /// (`Color.Rojo`) y `Color.todos`. Con `abrir`, anota los nombres públicos en `exports`.
    fn enumDecl(abrir: Bool, exports: Lista<Str>) -> Lista<Nodo> {
        fix kw = rango(bump())
        fix nt = expectIdentT("el nombre del enumerado")
        fix nombre = nt.valor
        fix nsp = rango(nt)
        fix abre = rango(expect("LBrace", "`{` y las variantes del enumerado"))
        fix variantes = Lista<Str>()
        fix rangos = Lista<Rango>()
        mut cierreEnum = kw
        while true {
            skipNewlines()
            fix t = tipo()
            if t == "RBrace" {
                cierreEnum = rango(bump())
                break
            } else if t == "Eof" {
                fail ErrorParse("este enumerado no se cierra: falta `}`", abre)
            } else if t == "Ident" {
                fix vt = bump()
                fix v = vt.valor
                if v == "todos" || variantes.contiene(v) {
                    fail ErrorParse("la variante `${v}` está repetida o es un nombre reservado del enumerado", rango(vt))
                }
                variantes.agrega(v)
                rangos.agrega(rango(vt))
                if tipo() == "Comma" {
                    bump()
                } else if tipo() != "Newline" && tipo() != "RBrace" {
                    fail aqui("se esperaba `,` o el fin de la línea después de la variante")
                }
            } else {
                fail aqui("se esperaba el nombre de una variante")
            }
        }
        if variantes.vacia() { fail ErrorParse("un enumerado necesita al menos una variante", kw.to(cierreEnum)) }
        fix span = kw.to(cierreEnum)
        fix decls = Lista<Nodo>()
        fix params = Lista<Nodo>()
        params.agrega(uno("CtorParam", "nombre fix", hoja("Type", "Str").en(nsp)).en(nsp).nom(nsp))
        params.agrega(uno("CtorParam", "orden fix", hoja("Type", "Int").en(nsp)).en(nsp).nom(nsp))
        fix hijos = Lista<Nodo>()
        hijos.agrega(vacio("TypeParams"))
        hijos.agrega(con("CtorParams", "", params))
        hijos.agrega(vacio("Supers"))
        hijos.agrega(vacio("Fields"))
        hijos.agrega(vacio("Methods"))
        decls.agrega(con("Thing", nombre, hijos).en(span).nom(nsp))
        if abrir { exports.agrega(nombre) }
        fix todas = Lista<Nodo>()
        mut i = 0
        while i < variantes.tam() {
            fix v = variantes.obtiene(i)
            fix vr = rangos.obtiene(i)
            fix completo = "${nombre}.${v}"
            fix args = Lista<Nodo>()
            args.agrega(hoja("Str", comillas(v)).en(vr))
            args.agrega(hoja("Int", "${i}").en(vr))
            fix llamada = dos("Call", nombre, vacio("TArgs"), con("Args", "", args)).en(vr)
            decls.agrega(dos("Let", "${completo} fix", nada(), llamada).en(vr).nom(vr))
            todas.agrega(hoja("Var", completo).en(vr))
            if abrir { exports.agrega(completo) }
            i += 1
        }
        fix lista = dos("Call", "_variantes", vacio("TArgs"), uno("Args", "", con("Array", "", todas).en(span))).en(span)
        decls.agrega(dos("Let", "${nombre}.todos fix", nada(), lista).en(span).nom(nsp))
        if abrir { exports.agrega("${nombre}.todos") }
        return decls
    }

    fn fresco() -> Str {
        cont.n += 1
        return "_m${cont.n}"
    }

    fn patron() -> Pat {
        if tipo() == "Ident" {
            fix n = peek().valor
            if n == "_" && (peekAt(1).tipo == "Arrow" || peekAt(1).tipo == "Comma") {
                bump()
                return Pat("Wild", nada(), "", nada(), Rango(0, 0))
            }
            if peekAt(1).tipo == "Colon" {
                fix r = rango(bump())
                bump()
                return Pat("Typed", nada(), n, typeRef(), r)
            }
        }
        return Pat("Value", condicion(), "", nada(), Rango(0, 0))
    }

    /// `match valor { patrón, patrón -> cuerpo ... }`. En la forma de valor cada cuerpo es una expresión; en la
    /// de sentencia, un bloque `{ ... }` o una sentencia.
    fn casos(esValor: Bool) -> Casos {
        fix scrut = condicion()
        fix abre = rango(expect("LBrace", "`{` y los casos del `match`"))
        fix lista = Lista<Caso>()
        mut cierreMatch = abre
        while true {
            skipNewlines()
            if tipo() == "RBrace" {
                cierreMatch = rango(bump())
                break
            }
            if tipo() == "Eof" { fail ErrorParse("este `match` no se cierra: falta `}`", abre) }
            fix inicio = rango(peek())
            fix pats = Lista<Pat>()
            pats.agrega(patron())
            while tipo() == "Comma" {
                bump()
                pats.agrega(patron())
            }
            if pats.tam() > 1 && pats.alguno({ p -> p.clase != "Value" }) {
                fail ErrorParse("varios patrones con `,` solo pueden ser valores (no `_` ni `nombre: Tipo`)", inicio)
            }
            expect("Arrow", "`->` y el cuerpo del caso")
            mut cuerpo = nada()
            if esValor {
                fix valor = expr(0)
                fix vr = rg(valor)
                cuerpo = con("Block", "", listaDe1(uno("Return", "", valor).en(vr))).en(vr)
            } else if tipo() == "LBrace" {
                cuerpo = bloque()
            } else {
                fix st = stmt()
                cuerpo = con("Block", "", listaDe1(st)).en(spanDe(st))
            }
            lista.agrega(Caso(pats, cuerpo, inicio.to(rg(cuerpo))))
            // Como valor el separador es opcional: dentro de `${...}` no hay saltos de línea.
            if !esValor && tipo() != "RBrace" { finSentencia(true) }
        }
        if lista.vacia() { fail ErrorParse("un `match` necesita al menos un caso", abre.to(cierreMatch)) }
        return Casos(scrut, lista, cierreMatch)
    }

    /// Un `match` sobre variantes de un enumerado de este archivo, sin `_`, tiene que nombrarlas todas.
    fn cubre(lista: Lista<Caso>, kw: Rango) {
        mut dueno = ""
        fix vistas = Lista<Str>()
        mut i = 0
        while i < lista.tam() {
            fix pats = lista.obtiene(i).pats
            mut j = 0
            while j < pats.tam() {
                fix p = pats.obtiene(j)
                if p.clase != "Value" || p.valor.tag != "Var" { return }
                fix completo = p.valor.attrs
                fix punto = completo.indiceDe(".")
                if punto < 0 { return }
                fix e = completo.trozo(0, punto)
                if !enums.contiene(e) || (dueno != "" && dueno != e) { return }
                dueno = e
                vistas.agrega(completo.trozo(punto + 1, completo.largo()))
                j += 1
            }
            i += 1
        }
        if dueno == "" { return }
        fix faltan = Lista<Str>()
        enums.obtiene(dueno)?.paraCada { v -> if !vistas.contiene(v) { faltan.agrega("`${dueno}.${v}`") } }
        if faltan.vacia() { return }
        fail ErrorParse("este `match` no cubre ${une(faltan, ", ")}: añade esos casos o un caso `_`", kw)
    }

    /// `fail Fallo("...")` para cuando ningún caso de un `match` coincide.
    fn sinCaso(r: Rango) -> Nodo {
        fix msg = hoja("Str", comillas("ningún caso del `match` coincide con el valor")).en(r)
        fix llamada = dos("Call", "Fallo", vacio("TArgs"), uno("Args", "", msg)).en(r)
        return con("Block", "", listaDe1(uno("Fail", "", llamada).en(r))).en(r)
    }

    /// Las sentencias que prueban cada caso en orden: `fix _mN = valor` y una cadena de `if`/`else`.
    fn cadena(c: Casos, kw: Rango) -> Lista<Nodo> {
        cubre(c.casos, kw)
        fix tmp = fresco()
        fix ultimo = c.casos.tam() - 1
        mut cola: Nodo? = nil
        mut cadenaIf: Nodo? = nil
        mut i = ultimo
        while i >= 0 {
            fix caso = c.casos.obtiene(i)
            fix cuerpo = caso.cuerpo
            if caso.pats.obtiene(0).clase == "Wild" {
                if i != ultimo { fail ErrorParse("el caso `_` coincide con todo: debe ser el último del `match`", caso.r) }
                cola = cuerpo
                i -= 1
                continue
            }
            mut cond: Nodo? = nil
            caso.pats.paraCada { p ->
                mut uno1 = nada()
                if p.clase == "Value" {
                    fix sp = rg(p.valor)
                    uno1 = dos("Binary", "==", hoja("Var", tmp).en(sp), p.valor).en(sp)
                } else {
                    cuerpo.kids.inserta(0, dos("Let", "${p.nombre} fix", nada(), dos("Cast", "", hoja("Var", tmp).en(p.r), p.ty).en(p.r)).en(p.r).nom(p.r))
                    uno1 = dos("Is", "", hoja("Var", tmp).en(p.r), p.ty).en(p.r)
                }
                fix previa = cond
                if previa == nil {
                    cond = uno1
                } else {
                    cond = dos("Binary", "||", previa, uno1).en(rg(previa).to(rg(uno1)))
                }
            }
            mut otro: Nodo = nada()
            fix siguiente = cadenaIf
            fix colaActual = cola
            if siguiente != nil {
                otro = con("Block", "", listaDe1(siguiente)).en(spanDe(siguiente))
                cadenaIf = nil
            } else if colaActual != nil {
                otro = colaActual
                cola = nil
            } else {
                otro = sinCaso(kw)
            }
            cadenaIf = tres("If", "", cond ?: nada(), cuerpo, otro).en(caso.r)
            i -= 1
        }
        fix salida = Lista<Nodo>()
        fix initR = rg(c.scrut)
        salida.agrega(dos("Let", "${tmp} fix", nada(), c.scrut).en(initR).nom(initR))
        fix final = cadenaIf
        if final != nil {
            salida.agrega(final)
        } else {
            fix soloCola = cola
            if soloCola != nil { soloCola.kids.paraCada { s -> salida.agrega(s) } }
        }
        return salida
    }

    fn matchStmt() -> Nodo {
        fix kw = rango(bump())
        fix c = casos(false)
        fix span = kw.to(c.cierre)
        fix stmts = cadena(c, kw)
        return tres("If", "", hoja("Bool", "true").en(kw), con("Block", "", stmts).en(span), sinCaso(kw)).en(span)
    }

    fn matchExpr(kw: Rango) -> Nodo {
        fix c = casos(true)
        fix span = kw.to(c.cierre)
        return inmediata(cadena(c, kw), span)
    }

    /// `if cond { a } else { b }` usado como valor.
    fn ifExpr(kw: Rango) -> Nodo {
        fix cond = condicion()
        fix a = exprEntreLlaves()
        skipNewlines()
        if tipo() != "Else" { fail aqui("un `if` usado como valor necesita `else` (si no, ¿qué valor tiene?)") }
        bump()
        mut b = nada()
        if tipo() == "If" {
            fix interior = rango(bump())
            b = ifExpr(interior)
        } else {
            b = exprEntreLlaves()
        }
        fix span = kw.to(rg(b))
        fix si = tres("If", "", cond, devuelve(a), devuelve(b)).en(span)
        return inmediata(listaDe1(si), span)
    }

    /// `{ return e }` con la posición de `e`.
    fn devuelve(e: Nodo) -> Nodo {
        fix s = rg(e)
        return con("Block", "", listaDe1(uno("Return", "", e).en(s))).en(s)
    }

    fn exprEntreLlaves() -> Nodo {
        expect("LBrace", "`{` y el valor")
        skipNewlines()
        fix v = exprAnidada()
        skipNewlines()
        expect("RBrace", "`}` después del valor")
        return v
    }

    // ------------------------------------------------------------ bloques y tipos

    fn bloque() -> Nodo {
        fix abre = rango(expect("LBrace", "`{`"))
        return bloqueResto(abre)
    }

    /// El resto de un bloque cuyo `{` ya se consumió.
    fn bloqueResto(abre: Rango) -> Nodo {
        fix stmts = Lista<Nodo>()
        while true {
            skipNewlines()
            if tipo() == "RBrace" {
                fix cierreB = rango(bump())
                return con("Block", "", stmts).en(abre.to(cierreB))
            }
            if tipo() == "Eof" { fail ErrorParse("este bloque no se cierra: falta `}`", abre) }
            stmts.agrega(stmt())
            if tipo() == "Eof" { fail ErrorParse("este bloque no se cierra: falta `}`", abre) }
            finSentencia(true)
        }
        return con("Block", "", stmts)
    }

    /// Parámetros de tipo `<T, U: Cota>` tras el nombre de una declaración (opcionales).
    fn typeParams() -> Nodo {
        fix lista = Lista<Nodo>()
        if tipo() != "Lt" { return con("TypeParams", "", lista) }
        bump()
        fix nombres = Lista<Str>()
        while true {
            fix nt = expectIdentT("el nombre del parámetro de tipo")
            fix nombre = nt.valor
            fix nsp = rango(nt)
            if nombres.contiene(nombre) { fail ErrorParse("el parámetro de tipo `${nombre}` está repetido", nsp) }
            nombres.agrega(nombre)
            mut cota = nada()
            mut span = nsp
            if tipo() == "Colon" {
                bump()
                cota = typeRef()
                span = nsp.to(rg(cota))
            }
            lista.agrega(uno("TypeParam", nombre, cota).en(span).nom(nsp))
            if tipo() == "Comma" {
                bump()
            } else {
                break
            }
        }
        expect("Gt", "`>` para cerrar los parámetros de tipo")
        return con("TypeParams", "", lista)
    }

    /// `<A, B>` seguido de `(` o de una lambda final, o nada: así `a < b` no se confunde con argumentos de tipo.
    fn tryTypeArgs() -> Lista<Nodo>? {
        if tipo() != "Lt" { return nil }
        bump()
        fix args = Lista<Nodo>()
        while true {
            mut ok = true
            attempt {
                args.agrega(typeRef())
            } rescue e: ErrorParse {
                ok = false
            }
            if !ok { return nil }
            if tipo() == "Comma" {
                bump()
            } else if tipo() == "Gt" {
                bump()
                break
            } else {
                return nil
            }
        }
        if tipo() == "LParen" || puedeTrail() { return args }
        return nil
    }

    fn typeRef() -> Nodo {
        mut t = baseTypeRef()
        // `T?`; con varios (`T??`) el verificador explica que no tiene sentido.
        while tipo() == "Question" {
            fix q = rango(bump())
            t = uno("Type", "Nullable", t).en(rg(t).to(q))
        }
        return t
    }

    fn baseTypeRef() -> Nodo {
        // `(Int, Str) -> Bool` (tipo de función) o `(T)` (agrupación, para `((Int) -> Int)?`).
        if tipo() == "LParen" {
            fix abre = rango(bump())
            fix items = Lista<Nodo>()
            if tipo() != "RParen" {
                while true {
                    items.agrega(typeRef())
                    if tipo() == "Comma" {
                        bump()
                    } else {
                        break
                    }
                }
            }
            fix cierreT = rango(expect("RParen", "`,` o `)` en el tipo"))
            if tipo() == "Arrow" {
                bump()
                fix ret = typeRef()
                items.agrega(ret)
                return con("Type", "Fn", items).en(abre.to(rg(ret)))
            }
            if items.tam() == 1 { return items.obtiene(0) }
            fail ErrorParse("un tipo de función necesita `->` y el tipo que devuelve, por ejemplo `(Int) -> Int`", abre.to(cierreT))
        }
        if tipo() == "LBracket" {
            fix abre = rango(bump())
            fix elem = typeRef()
            fix cierreT = rango(expect("RBracket", "`]` para cerrar el tipo"))
            return uno("Type", "Array", elem).en(abre.to(cierreT))
        }
        fix nm = identCualificado("un nombre de tipo")
        // `Lista<Int>`, `Mapa<Str, [Int]>`
        if tipo() == "Lt" {
            bump()
            fix args = Lista<Nodo>()
            while true {
                args.agrega(typeRef())
                if tipo() == "Comma" {
                    bump()
                } else {
                    break
                }
            }
            fix cierreT = rango(expect("Gt", "`>` para cerrar los argumentos de tipo"))
            return con("Type", nm.nombre, args).en(nm.r.to(cierreT))
        }
        return hoja("Type", nm.nombre).en(nm.r)
    }

    // ------------------------------------------------------------ sentencias

    fn stmt() -> Nodo {
        fix t = tipo()
        match t {
            "Fix", "Mut" -> return letStmt()
            "If" -> return ifStmt()
            "While" -> return whileStmt()
            "Return" -> return returnStmt()
            "Show" -> return showStmt()
            "Break", "Continue" -> return jumpStmt()
            "Fn" -> fail aqui("las funciones solo se pueden declarar al nivel superior del archivo")
            "Match" -> return matchStmt()
            "Enum" -> fail aqui("los enumerados solo se pueden declarar al nivel superior del archivo")
            "Attempt" -> return attemptStmt()
            "Fail" -> {
                fix inicio = rango(bump())
                fix valor = expr(0)
                return uno("Fail", "", valor).en(inicio.to(rg(valor)))
            }
            "Rescue" -> fail aqui("`rescue` solo puede ir después de un bloque `attempt { ... }`")
            "Thing" -> fail aqui("las clases solo se pueden declarar al nivel superior del archivo")
            "Kind" -> fail aqui("las interfaces solo se pueden declarar al nivel superior del archivo")
            "Else" -> fail aqui("`else` debe ir en la misma línea que la `}` del `if`")
            _ -> {
                if t == "Ident" && ASIGNA.obtiene(peekAt(1).tipo) != nil { return assignStmt() }
                fix e = expr(0)
                fix op = ASIGNA.obtiene(tipo())
                if e.tag == "Index" && op != nil {
                    bump()
                    fix valor = expr(0)
                    return tres("IndexAssign", op, e.kids.obtiene(0), e.kids.obtiene(1), valor).en(rg(e).to(rg(valor)))
                }
                if e.tag == "Field" && op != nil {
                    bump()
                    fix valor = expr(0)
                    return dos("FieldAssign", "${e.attrs} ${op}", e.kids.obtiene(0), valor).en(rg(e).to(rg(valor))).nom(Rango(e.nd, e.nh))
                }
                return uno("ExprStmt", "", e)
            }
        }
        fail aqui("sentencia no válida")
    }

    /// `thing Nombre(params) { campos y métodos }`; el cuerpo es opcional.
    fn thingDecl() -> Nodo {
        fix inicio = rango(bump())
        fix nt = expectIdentT("el nombre de la clase")
        fix nombre = nt.valor
        fix nsp = rango(nt)
        fix tparams = typeParams()
        expect("LParen", "`(` con los parámetros del constructor")
        fix params = Lista<Nodo>()
        fix nombres = Lista<Str>()
        if tipo() != "RParen" {
            while true {
                mut mutab = "-"
                if tipo() == "Fix" {
                    bump()
                    mutab = "fix"
                } else if tipo() == "Mut" {
                    bump()
                    mutab = "mut"
                }
                fix pt = expectIdentT("el nombre del parámetro")
                fix pnombre = pt.valor
                fix psp = rango(pt)
                if nombres.contiene(pnombre) { fail ErrorParse("el parámetro `${pnombre}` está repetido", psp) }
                nombres.agrega(pnombre)
                expect("Colon", "`:` y el tipo del parámetro")
                fix pty = typeRef()
                params.agrega(uno("CtorParam", "${pnombre} ${mutab}", pty).en(psp.to(rg(pty))).nom(psp))
                if tipo() == "Comma" {
                    bump()
                } else {
                    break
                }
            }
        }
        mut fin = rango(expect("RParen", "`,` o `)`"))
        fix supers = Lista<Nodo>()
        if tipo() == "Colon" {
            bump()
            while true {
                fix sn = identCualificado("el nombre de una clase o interfaz")
                fix targs = Lista<Nodo>()
                mut cabeza = sn.r
                if tipo() == "Lt" {
                    bump()
                    while true {
                        targs.agrega(typeRef())
                        if tipo() == "Comma" {
                            bump()
                        } else {
                            break
                        }
                    }
                    cabeza = sn.r.to(rango(expect("Gt", "`>` para cerrar los argumentos de tipo")))
                }
                mut args = nada()
                mut span = cabeza
                if tipo() == "LParen" {
                    args = con("Args", "", callArgs())
                    span = sn.r.to(cierre)
                }
                fin = span
                supers.agrega(dos("Super", sn.nombre, con("TArgs", "", targs), args).en(span).nom(sn.r))
                if tipo() == "Comma" {
                    bump()
                } else {
                    break
                }
            }
        }
        fix campos = Lista<Nodo>()
        fix metodos = Lista<Nodo>()
        if tipo() == "LBrace" {
            fix abre = rango(bump())
            while true {
                skipNewlines()
                fix t = tipo()
                if t == "RBrace" {
                    fin = rango(bump())
                    break
                } else if t == "Eof" {
                    fail ErrorParse("esta clase no se cierra: falta `}`", abre)
                } else if t == "Fix" || t == "Mut" {
                    fix l = letStmt()
                    campos.agrega(Nodo("FieldDecl", l.attrs, l.kids).en(rg(l)).nom(Rango(l.nd, l.nh)))
                } else if t == "Fn" {
                    metodos.agrega(fnDecl())
                } else {
                    fail aqui("dentro de una clase se esperaba un campo (`fix`/`mut`) o un método (`fn`), pero se encontró ${describe(peek())}")
                }
                if tipo() == "Eof" { fail ErrorParse("esta clase no se cierra: falta `}`", abre) }
                finSentencia(true)
            }
        }
        fix hijos = Lista<Nodo>()
        hijos.agrega(tparams)
        hijos.agrega(con("CtorParams", "", params))
        hijos.agrega(con("Supers", "", supers))
        hijos.agrega(con("Fields", "", campos))
        hijos.agrega(con("Methods", "", metodos))
        return con("Thing", nombre, hijos).en(inicio.to(fin)).nom(nsp)
    }

    /// `kind Nombre { fn m(params) -> T ... }`: solo firmas.
    fn kindDecl() -> Nodo {
        fix inicio = rango(bump())
        fix nt = expectIdentT("el nombre de la interfaz")
        fix nombre = nt.valor
        fix nsp = rango(nt)
        fix tparams = typeParams()
        fix abre = rango(expect("LBrace", "`{`"))
        fix metodos = Lista<Nodo>()
        mut fin = abre
        while true {
            skipNewlines()
            fix t = tipo()
            if t == "RBrace" {
                fin = rango(bump())
                break
            } else if t == "Eof" {
                fail ErrorParse("esta interfaz no se cierra: falta `}`", abre)
            } else if t == "Fn" {
                fix fstart = rango(bump())
                fix mt = expectIdentT("el nombre del método")
                fix mnombre = mt.valor
                fix msp = rango(mt)
                fix params = parametros()
                mut ret = nada()
                mut hasta = msp
                if tipo() == "Arrow" {
                    bump()
                    ret = typeRef()
                    hasta = rg(ret)
                }
                if tipo() == "LBrace" || tipo() == "Assign" {
                    fail aqui("los métodos de una interfaz no llevan cuerpo; lo implementan las clases")
                }
                metodos.agrega(dos("KMethod", mnombre, params, ret).en(fstart.to(hasta)).nom(msp))
            } else {
                fail aqui("dentro de una interfaz se esperaba un método (`fn`), pero se encontró ${describe(peek())}")
            }
            if tipo() == "Eof" { fail ErrorParse("esta interfaz no se cierra: falta `}`", abre) }
            finSentencia(true)
        }
        return dos("Kind", nombre, tparams, con("KMethods", "", metodos)).en(inicio.to(fin)).nom(nsp)
    }

    /// Lista de parámetros `(a: T, b: U)`; el siguiente token es `(`.
    fn parametros() -> Nodo {
        expect("LParen", "`(`")
        fix params = Lista<Nodo>()
        fix nombres = Lista<Str>()
        if tipo() != "RParen" {
            while true {
                fix pt = expectIdentT("el nombre del parámetro")
                fix pnombre = pt.valor
                fix psp = rango(pt)
                if nombres.contiene(pnombre) { fail ErrorParse("el parámetro `${pnombre}` está repetido", psp) }
                nombres.agrega(pnombre)
                expect("Colon", "`:` y el tipo del parámetro")
                fix pty = typeRef()
                params.agrega(uno("Param", pnombre, pty).en(psp.to(rg(pty))))
                if tipo() == "Comma" {
                    bump()
                } else {
                    break
                }
            }
        }
        expect("RParen", "`,` o `)`")
        return con("Params", "", params)
    }

    /// `attempt { ... } rescue e: Tipo { ... } rescue ...`; los `rescue` pueden ir en la línea siguiente.
    fn attemptStmt() -> Nodo {
        fix inicio = rango(bump())
        fix hijos = Lista<Nodo>()
        fix cuerpo = bloque()
        hijos.agrega(cuerpo)
        mut fin = rg(cuerpo)
        mut rescues = 0
        while true {
            fix guardado = pos
            skipNewlines()
            if tipo() != "Rescue" {
                pos = guardado
                break
            }
            fix palabra = rango(bump())
            fix nt = expectIdentT("el nombre de la variable del error")
            expect("Colon", "`:` y el tipo del error")
            fix ty = typeRef()
            fix bloqueR = bloque()
            fin = rg(bloqueR)
            hijos.agrega(dos("Rescue", nt.valor, ty, bloqueR).en(palabra.to(rg(bloqueR))).nom(rango(nt)))
            rescues += 1
        }
        if rescues == 0 { fail ErrorParse("un `attempt` necesita al menos un `rescue` después de su bloque", inicio) }
        return con("Attempt", "", hijos).en(inicio.to(fin))
    }

    fn letStmt() -> Nodo {
        fix palabra = bump()
        fix nt = expectIdentT("el nombre de la variable")
        mut ty = nada()
        if tipo() == "Colon" {
            bump()
            ty = typeRef()
        }
        expect("Assign", "`=` y el valor inicial")
        fix init = expr(0)
        return dos("Let", "${nt.valor} ${if palabra.tipo == "Mut" { "mut" } else { "fix" }}", ty, init).en(rango(palabra).to(rg(init))).nom(rango(nt))
    }

    fn assignStmt() -> Nodo {
        fix nt = expectIdentT("el nombre de la variable")
        fix op = ASIGNA.obtiene(bump().tipo) ?: "="
        fix valor = expr(0)
        return uno("Assign", "${nt.valor} ${op}", valor).en(rango(nt).to(rg(valor))).nom(rango(nt))
    }

    fn ifStmt() -> Nodo {
        fix inicio = rango(bump())
        fix cond = condicion()
        fix entonces = bloque()
        mut fin = rg(entonces)
        mut otro = nada()
        if tipo() == "Else" {
            bump()
            if tipo() == "If" {
                fix anidado = ifStmt()
                fin = rg(anidado)
                otro = con("Block", "", listaDe1(anidado)).en(fin)
            } else {
                otro = bloque()
                fin = rg(otro)
            }
        }
        return tres("If", "", cond, entonces, otro).en(inicio.to(fin))
    }

    /// Lambda `{ a, b: Int -> cuerpo }`; el `{` ya se consumió. Sin `->` no tiene parámetros.
    fn lambda(abre: Rango) -> Nodo {
        fix guardado = pos
        mut params = lambdaParams()
        if params == nil {
            pos = guardado
            params = Lista<Nodo>()
        }
        fix fnAntes = fnDepth
        fix loopAntes = loopDepth
        fnDepth = 1
        loopDepth = 0
        fix trailAntes = noTrailing
        noTrailing = false
        fix cuerpo = bloqueResto(abre)
        noTrailing = trailAntes
        fnDepth = fnAntes
        loopDepth = loopAntes
        return dos("Lambda", "", con("LParams", "", params ?: Lista<Nodo>()), cuerpo).en(rg(cuerpo))
    }

    /// `a, b: Int ->`; nil si lo que sigue no es una lista de parámetros.
    fn lambdaParams() -> Lista<Nodo>? {
        fix params = Lista<Nodo>()
        fix nombres = Lista<Str>()
        if tipo() == "Arrow" {
            bump()
            return params
        }
        while true {
            if tipo() != "Ident" { return nil }
            fix nt = bump()
            fix nombre = nt.valor
            if nombres.contiene(nombre) { return nil }
            nombres.agrega(nombre)
            mut ty = nada()
            if tipo() == "Colon" {
                bump()
                mut ok = true
                attempt {
                    ty = typeRef()
                } rescue e: ErrorParse {
                    ok = false
                }
                if !ok { return nil }
            }
            params.agrega(uno("LParam", nombre, ty).nom(rango(nt)))
            if tipo() == "Comma" {
                bump()
            } else if tipo() == "Arrow" {
                bump()
                return params
            } else {
                return nil
            }
        }
        return nil
    }

    fn whileStmt() -> Nodo {
        fix inicio = rango(bump())
        fix cond = condicion()
        loopDepth += 1
        fix cuerpo = bloque()
        loopDepth -= 1
        return dos("While", "", cond, cuerpo).en(inicio.to(rg(cuerpo)))
    }

    fn returnStmt() -> Nodo {
        fix palabra = rango(bump())
        if fnDepth == 0 { fail ErrorParse("`return` solo se puede usar dentro de una función", palabra) }
        fix t = tipo()
        if t == "Newline" || t == "RBrace" || t == "Eof" { return uno("Return", "", nada()).en(palabra) }
        fix valor = expr(0)
        return uno("Return", "", valor).en(palabra.to(rg(valor)))
    }

    fn jumpStmt() -> Nodo {
        fix palabra = bump()
        if loopDepth == 0 {
            fail ErrorParse("`${TEXTOS.obtiene(palabra.tipo) ?: ""}` solo se puede usar dentro de un `while`", rango(palabra))
        }
        return vacio(palabra.tipo).en(rango(palabra))
    }

    fn showStmt() -> Nodo {
        fix inicio = rango(bump())
        expect("LParen", "`(` después de `show`")
        fix valor = expr(0)
        fix cierreS = rango(expect("RParen", "`)`"))
        return uno("Show", "", valor).en(inicio.to(cierreS))
    }

    fn fnDecl() -> Nodo {
        fix inicio = rango(bump())
        fix nt = expectIdentT("el nombre de la función")
        fix nombre = nt.valor
        fix tparams = typeParams()
        fix params = parametros()
        mut ret = nada()
        if tipo() == "Arrow" {
            bump()
            ret = typeRef()
        }
        fix exprBody = tipo() == "Assign"
        fnDepth += 1
        mut cuerpo = nada()
        if tipo() == "LBrace" {
            cuerpo = bloque()
        } else if exprBody {
            bump()
            cuerpo = devuelve(expr(0))
        } else {
            fail aqui("se esperaba `{` o `=` para el cuerpo de la función, pero se encontró ${describe(peek())}")
        }
        fnDepth -= 1
        return cuatro("Fn", "${nombre} ${exprBody}", tparams, params, ret, cuerpo).en(inicio.to(rg(cuerpo))).nom(rango(nt))
    }

    // ------------------------------------------------------------ expresiones

    /// Pratt: `minBp` es el poder de enlace mínimo que debe tener un operador para seguir.
    fn expr(minBp: Int) -> Nodo {
        fix token = bump()
        fix r = rango(token)
        mut lhs = nada()
        match token.tipo {
            "Int" -> lhs = hoja("Int", token.valor).en(r)
            "Float" -> lhs = hoja("Float", token.valor).en(r)
            "True" -> lhs = hoja("Bool", "true").en(r)
            "False" -> lhs = hoja("Bool", "false").en(r)
            "Str" -> lhs = cadenaExpr(token.partes, r)
            "LBracket" -> lhs = arreglo(r)
            "Minus", "Bang" -> {
                fix operando = expr(13)
                lhs = uno("Unary", if token.tipo == "Minus" { "Neg" } else { "Not" }, operando).en(r.to(rg(operando)))
            }
            "LParen" -> {
                lhs = exprAnidada()
                expect("RParen", "`)`")
            }
            "LBrace" -> lhs = lambda(r)
            "Match" -> lhs = matchExpr(r)
            "If" -> lhs = ifExpr(r)
            "This" -> lhs = vacio("This").en(r)
            "Nil" -> lhs = vacio("Nil").en(r)
            "Super" -> {
                expect("Dot", "`.` después de `super`")
                fix nt = expectIdentT("el nombre de un método de la clase padre")
                if tipo() != "LParen" {
                    fail aqui("`super` solo se usa para llamar métodos: `super.metodo(...)`")
                }
                fix args = callArgs()
                lhs = uno("SuperCall", nt.valor, con("Args", "", args)).en(r.to(cierre)).nom(rango(nt))
            }
            "Ident" -> lhs = identificador(token.valor, r)
            _ -> fail ErrorParse("se esperaba una expresión, pero se encontró ${describe(token)}", r)
        }

        // Postfijos `a[i]`, `a.campo` y `a.metodo(args)`, los más fuertes de todos.
        while true {
            fix t = tipo()
            if t == "LBracket" {
                bump()
                fix indice = exprAnidada()
                fix cierreI = rango(expect("RBracket", "`]`"))
                lhs = dos("Index", "", lhs, indice).en(rg(lhs).to(cierreI))
            } else if t == "LParen" {
                // `f(1)(2)`, `obj.campo(1)(2)`: llama al valor de tipo función de la izquierda.
                fix args = callArgsTrailing()
                lhs = dos("CallValue", "", lhs, con("Args", "", args)).en(rg(lhs).to(cierre))
            } else if t == "QDot" {
                bump()
                fix nt = expectIdentT("el nombre de un campo o método después de `?.`")
                fix nsp = rango(nt)
                if tipo() == "LParen" || puedeTrail() {
                    fix args = callArgsTrailing()
                    lhs = dos("SafeCall", nt.valor, lhs, con("Args", "", args)).en(rg(lhs).to(cierre)).nom(nsp)
                } else {
                    lhs = uno("SafeField", nt.valor, lhs).en(rg(lhs).to(nsp)).nom(nsp)
                }
            } else if t == "Dot" {
                bump()
                fix nt = expectIdentT("el nombre de un campo o método después de `.`")
                fix nombre = nt.valor
                fix nsp = rango(nt)
                // `obj.metodo<Int>(x)`; si no encaja, `<` era una comparación.
                mut targs = Lista<Nodo>()
                if tipo() == "Lt" {
                    fix guardado = pos
                    fix hallados = tryTypeArgs()
                    if hallados == nil {
                        pos = guardado
                    } else {
                        targs = hallados
                    }
                }
                if tipo() == "LParen" || puedeTrail() {
                    fix args = callArgsTrailing()
                    lhs = tres("MethodCall", nombre, lhs, con("TArgs", "", targs), con("Args", "", args)).en(rg(lhs).to(cierre)).nom(nsp)
                } else if lhs.tag == "Var" && enums.contiene(lhs.attrs) {
                    // `Color.Rojo`: la constante global de esa variante.
                    lhs = hoja("Var", "${lhs.attrs}.${nombre}").en(rg(lhs).to(nsp))
                } else {
                    lhs = uno("Field", nombre, lhs).en(rg(lhs).to(nsp)).nom(nsp)
                }
            } else {
                break
            }
        }

        while true {
            fix t = tipo()
            // `x is T` (al nivel de las comparaciones) y `x as T` (más fuerte que la aritmética).
            if t == "Is" || t == "As" {
                if (if t == "Is" { 7 } else { 14 }) < minBp { break }
                bump()
                fix ty = typeRef()
                lhs = dos(if t == "Is" { "Is" } else { "Cast" }, "", lhs, ty).en(rg(lhs).to(rg(ty)))
                continue
            }
            // `a ?: b`, el operador de menor precedencia.
            if t == "Elvis" {
                if 0 < minBp { break }
                bump()
                fix derecha = expr(1)
                lhs = dos("Elvis", "", lhs, derecha).en(rg(lhs).to(rg(derecha)))
                continue
            }
            fix izq = bpIzq(t)
            if izq == 0 || izq < minBp { break }
            bump()
            fix derecha = expr(izq + 1)
            lhs = dos("Binary", BIN.obtiene(t) ?: t, lhs, derecha).en(rg(lhs).to(rg(derecha)))
        }
        return lhs
    }

    /// Un identificador al principio de una expresión: variable, llamada o llamada con lambda final.
    fn identificador(nombre: Str, r: Rango) -> Nodo {
        if tipo() == "LParen" { return llamada(nombre, vacio("TArgs"), r) }
        fix lambdaFinal = trailingLambda()
        if lambdaFinal != nil {
            // `repite { ... }`: llamada cuyo único argumento es la lambda.
            return dos("Call", nombre, vacio("TArgs"), uno("Args", "", lambdaFinal)).en(r.to(rg(lambdaFinal)))
        }
        if tipo() == "Lt" {
            // `f<Int>(x)` o `Lista<Int>()`; si no encaja, era una comparación.
            fix guardado = pos
            fix targs = tryTypeArgs()
            if targs != nil { return llamada(nombre, con("TArgs", "", targs), r) }
            pos = guardado
        }
        return hoja("Var", nombre).en(r)
    }

    /// Lambda final (`lista.map { x -> x }`) si el siguiente token es `{` y está permitida.
    fn trailingLambda() -> Nodo? {
        if !puedeTrail() { return nil }
        fix abre = rango(bump())
        return lambda(abre)
    }

    /// Cadena literal: sin interpolaciones es `Str`; con ellas, `Interp`.
    fn cadenaExpr(partes: Lista<Parte>, r: Rango) -> Nodo {
        fix salida = Lista<Nodo>()
        partes.paraCada { p ->
            if !p.esCodigo {
                salida.agrega(hoja("Text", comillas(p.texto)))
            } else {
                fix interno = Parser(p.codigo, enums, cont, fnDepth, loopDepth)
                fix e = interno.expr(0)
                if interno.tipo() != "RBrace" {
                    fail interno.aqui("la interpolación `\${...}` admite una sola expresión, pero se encontró ${describe(interno.peek())}")
                }
                salida.agrega(e)
            }
        }
        if salida.tam() == 1 && salida.obtiene(0).tag == "Text" {
            return hoja("Str", salida.obtiene(0).attrs).en(r)
        }
        return con("Interp", "", salida).en(r)
    }

    /// Literal `[a, b, c]`; el `[` ya se consumió. Admite saltos de línea entre elementos.
    fn arreglo(abre: Rango) -> Nodo {
        fix elems = Lista<Nodo>()
        while true {
            skipNewlines()
            if tipo() == "RBracket" { break }
            elems.agrega(exprAnidada())
            skipNewlines()
            if tipo() == "Comma" {
                bump()
            } else {
                break
            }
        }
        skipNewlines()
        fix cierreA = rango(expect("RBracket", "`,` o `]`"))
        return con("Array", "", elems).en(abre.to(cierreA))
    }

    /// Llamada `nombre(args)`; el nombre ya se consumió y el siguiente token es `(`.
    fn llamada(nombre: Str, targs: Nodo, r: Rango) -> Nodo {
        fix args = callArgsTrailing()
        return dos("Call", nombre, targs, con("Args", "", args)).en(r.to(cierre))
    }

    /// Argumentos `(a, b)` y/o una lambda final: `f(a) { ... }`, `x.m { ... }`.
    fn callArgsTrailing() -> Lista<Nodo> {
        mut args = Lista<Nodo>()
        if tipo() == "LParen" {
            args = callArgs()
        } else {
            cierre = rango(peek())
        }
        fix lambdaFinal = trailingLambda()
        if lambdaFinal != nil {
            cierre = rg(lambdaFinal)
            args.agrega(lambdaFinal)
        }
        return args
    }

    /// Argumentos `(a, b)`; el siguiente token es `(`.
    fn callArgs() -> Lista<Nodo> {
        bump()
        fix args = Lista<Nodo>()
        if tipo() != "RParen" {
            while true {
                args.agrega(exprAnidada())
                if tipo() == "Comma" {
                    bump()
                } else {
                    break
                }
            }
        }
        cierre = rango(expect("RParen", "`,` o `)`"))
        return args
    }
}

// ---------------------------------------------------------------- volcado

open fn vuelca(n: Nodo, sangria: Str, salida: Lista<Str>) {
    mut linea = "${sangria}${n.tag}"
    if n.attrs != "" { linea += " ${n.attrs}" }
    if n.d >= 0 { linea += " @${n.d}-${n.h}" }
    if n.nd >= 0 { linea += " #${n.nd}-${n.nh}" }
    salida.agrega(linea)
    n.kids.paraCada { k -> vuelca(k, sangria + "  ", salida) }
}

/// Los enumerados del archivo y sus variantes, para reconocer `Color.Rojo` antes de haber visto la
/// declaración y para comprobar que un `match` los cubre todos.
fn enumerados(toks: Lista<Token>) -> Mapa<Str, Lista<Str>> {
    fix m = Mapa<Str, Lista<Str>>()
    mut i = 0
    while i + 2 < toks.tam() {
        if toks.obtiene(i).tipo == "Enum" && toks.obtiene(i + 1).tipo == "Ident" && toks.obtiene(i + 2).tipo == "LBrace" {
            fix vars = Lista<Str>()
            mut j = i + 3
            while j < toks.tam() && toks.obtiene(j).tipo != "RBrace" {
                if toks.obtiene(j).tipo == "Ident" { vars.agrega(toks.obtiene(j).valor) }
                j += 1
            }
            m.pone(toks.obtiene(i + 1).valor, vars)
        }
        i += 1
    }
    return m
}

/// El árbol de un programa completo. Falla con `ErrorLexico` o `ErrorParse`.
open fn analiza(texto: Str) -> Nodo {
    fix toks = lexea(texto)
    return Parser(toks, enumerados(toks), Contador(), 0, 0).programa()
}

/// Como `analiza`, con todas las posiciones (del árbol y de los errores) movidas `base` caracteres.
open fn analizaEn(texto: Str, base: Int) -> Nodo {
    attempt {
        fix toks = desplaza(lexea(texto), base)
        return Parser(toks, enumerados(toks), Contador(), 0, 0).programa()
    } rescue e: ErrorLexico {
        fail ErrorLexico(e.msg, e.desde + base, e.hasta + base)
    }
}

fn main() {
    fix a = argumentos()
    if a.tam() != 1 {
        show("uso: and23 mn/parser.jb archivo.jb")
        return
    }
    attempt {
        fix toks = lexea(leeArchivo(a.obtiene(0)))
        fix p = Parser(toks, enumerados(toks), Contador(), 0, 0)
        fix salida = Lista<Str>()
        vuelca(p.programa(), "", salida)
        show(une(salida, "\n"))
    } rescue e: ErrorLexico {
        show("Error ${e.msg} @${e.desde}-${e.hasta}")
    } rescue e: ErrorParse {
        show("Error ${e.msg} @${e.donde.a}-${e.donde.b}")
    }
}
