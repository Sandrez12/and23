fix a = 1
if a == 1 {
    fix fib: (Int) -> Int = { n -> if n < 2 { return n } else { return fib(n - 1) + fib(n - 2) } }
    show(fib(15))
}
thing Calc() {
    fn fact(n: Int) -> Int {
        fix f: (Int) -> Int = { k ->
            if k <= 1 { return 1 }
            return k * f(k - 1)
        }
        return f(n)
    }
}
show(Calc().fact(6))
